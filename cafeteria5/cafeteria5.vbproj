<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- No se usa el proyecto My: el punto de entrada es Public Sub Main en Program.vb. -->
    <MyType>Empty</MyType>
  </PropertyGroup>

  <PropertyGroup>
    <OptionExplicit>On</OptionExplicit>
    <OptionStrict>On</OptionStrict>
    <OptionInfer>On</OptionInfer>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <!--
    Pruebas/ son tres proyectos aparte, cada uno con su propio punto de entrada. Si el
    proyecto principal los compilara, tendria cuatro Mains y no arrancaria.
  -->
  <ItemGroup>
    <Compile Remove="Pruebas\**" />
    <None Include="Pruebas\**" />
  </ItemGroup>

</Project>
